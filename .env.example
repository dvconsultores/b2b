# Copy to .env and fill in. .env is never committed (see .gitignore).

## Sending — Amazon SES SMTP
HOST_EMAIL=email-smtp.<region>.amazonaws.com
PORT_EMAIL=465
USER_EMAIL=
PASS_EMAIL=
SENDER_EMAIL=
SMTP_FROM_NAME=

## Test mode and end-of-batch summary email (your own addresses, comma-separated)
TEST_RECIPIENTS=

## Docker Hub (deploy.sh; image name in b2b.yml)
DOCKER_USERNAME=
DOCKER_PASSWORD=

## Server (push-db.sh, push-contactos.sh)
SRVUSER=
SRVPASS=
SRVHOST=
SRVDB_LOCATION=/opt/b2b/data
SRVCONTACTOS_LOCATION=/opt/b2b/contactos
LOCADB_LOCATION=data
DBNAME=b2b.sqlite3

## Container start (b2b.yml): import contactos/ into the database before sending
IMPORT_ON_START=1
CLIENTS_FILE=ClientesFebrero2020.xls
YEARBOOK_FILE="Year Book 2009.xlsx"

## SES API read-only key (sync_bounces and the send guard) — IAM user with ses:GetAccount,
## ses:GetSendQuota, ses:GetSendStatistics, ses:ListSuppressedDestinations,
## ses:GetSuppressedDestination, cloudwatch:GetMetricData only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

## Never set CONFIRM_CAMPAIGN here — pass it on the command line for each launch.
